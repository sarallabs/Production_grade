# ─── Firebase Client SDK ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Google API Keys (⚠️ THESE WILL MOVE SERVER-SIDE IN PHASE 1) ───
# Used for Gemini AI, Cloud TTS, and Cloud STT
# VITE_GOOGLE_API_KEY=your-google-api-key
# VITE_GEMINI_API_KEY=your-gemini-api-key

# ─── App Configuration ───
# Default password for student login (will be removed in Phase 2 — Firebase Auth)
# VITE_DEFAULT_PASSWORD=

# Comma-separated list of board IDs to show (e.g., cbse,neb_nepal,master_minds)
# VITE_VISIBLE_BOARDS=

# Backend API base URL (leave empty for static-only mode)
# VITE_API_BASE_URL=

# Expert Panel API URL (local dev only)
# VITE_API_URL=http://localhost:3001

# TinyMCE editor key (for Expert Panel rich text editing)
# VITE_TINYMCE_API_KEY=

# ─── Server-Side Only (not bundled by Vite) ───
# GitHub integration for Expert Panel
# GITHUB_PAT=
# GITHUB_REPO_OWNER=
# GITHUB_REPO_NAME=
# GITHUB_TARGET_BRANCH=main
# GITHUB_AUTO_PR=false

# Express server port
# PORT=3001
