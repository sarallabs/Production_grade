# Yarn Integrity file
.yarn-integrity

# dotenv environment variables — see CREDENTIALS section below


# dataconnect generated files
.dataconnect

# Vite cache
.vite-cache/

# Large generated audio/media files in dist (served via CDN or regenerated)
dist/generated_resources/**/*.m4a
dist/generated_resources/**/*.wav
dist/generated_resources/**/*.ogg
dist/generated_resources/**/*.aac

# Large generated audio/media files in public
public/generated_resources/**/*.mp3
# Allow Master Minds podcast MP3s to be tracked (see docs/git-lfs-master-minds.md)
!public/generated_resources/master_minds/
!public/generated_resources/master_minds/**/
!public/generated_resources/master_minds/**/*.mp3
# Allow NEB Nepal podcast MP3s to be tracked (see docs/git-lfs-master-minds.md)
!public/generated_resources/neb_nepal/
!public/generated_resources/neb_nepal/**/
!public/generated_resources/neb_nepal/**/*.mp3
# Allow Nagarjuna_University podcast MP3s to be tracked
!public/generated_resources/Nagarjuna_University/
!public/generated_resources/Nagarjuna_University/**/
!public/generated_resources/Nagarjuna_University/**/*.mp3
public/generated_resources/**/*.m4a
public/generated_resources/**/*.wav
public/generated_resources/**/*.ogg
public/generated_resources/**/*.aac

