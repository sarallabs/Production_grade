{
  "hosting": {
    "site": "saralvidhya-anu",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "version": {
      "deletePreviousVersions": true
    }
  }
}
