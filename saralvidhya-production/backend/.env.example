# ==============================================================================
# Saral Vidhya Production Backend Environment Configuration Template
# COPY this file to .env for local development: cp .env.example .env
# DO NOT COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Server Network Configuration
PORT=8080
NODE_ENV=development

# Security & Session Authentication
# In production, injected into Cloud Run via GCP Secret Manager (sv-session-secret)
SESSION_SECRET=your-secure-random-session-secret-at-least-32-chars

# Google Generative AI (Gemini 1.5 Flash Proxy)
# In production, injected into Cloud Run via Secret Manager or GCP Application Default Credentials
GEMINI_API_KEY=your-gemini-api-key

# Google Cloud Platform & Storage
GCP_PROJECT_ID=saralvidhya-production
FIREBASE_PROJECT_ID=ekam-expert-prod
GCS_BUCKET_NAME=saralvidhya-artifacts

# CORS & Frontend Origins (comma-separated or single origin)
ALLOWED_ORIGIN=http://localhost:5173

# Local Google Cloud Service Account (Local development only; on GCP Cloud Run, ADC is used automatically)
# GOOGLE_APPLICATION_CREDENTIALS=../firebase-service-account.json
