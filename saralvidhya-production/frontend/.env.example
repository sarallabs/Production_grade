# ==============================================================================
# Saral Vidhya Production Frontend Environment Template
# COPY this file to .env.local for local development: cp .env.example .env.local
# DO NOT COMMIT .env.local TO VERSION CONTROL.
# NOTE: All variables prefixed with VITE_ are public and exposed to the browser.
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Firebase Client SDK Configuration (Ekam Expert Prod)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Local Development Authentication Overrides
VITE_DEFAULT_PASSWORD=your-local-student-password
VITE_EXPERT_PASSWORD=your-local-expert-password

# Optional Frontend Direct Key (Used for local offline testing of Ask AI / Cloud TTS)
# In production, these calls are proxied through VITE_API_BASE_URL
# VITE_GOOGLE_API_KEY=your-google-api-key

# Third-Party UI Tools
# VITE_TINYMCE_API_KEY=your-tinymce-key
