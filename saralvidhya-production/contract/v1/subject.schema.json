{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubjectConfig",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string"
    },
    "parentNodeId": {
      "type": ["string", "null"]
    },
    "order": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": ["active", "archived"]
    },
    "faculty": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "avatarBlob": { "type": "string" }
      }
    },
    "units": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
