{
  "contractVersion": "1.0.0",
  "description": "Single source of truth for which files make which tool appear in a chapter. Backend, CLI and frontend all read this file. Never hardcode a tool or path anywhere else. Patterns are relative to a chapter folder; {name} placeholders are captured as parameters.",
  "params": {
    "persona": ["beginner", "intermediate", "advanced"],
    "level": ["beginner", "intermediate", "advanced"],
    "difficulty": ["easy", "medium", "hard"]
  },
  "tools": [
    { "id": "read.quick", "section": "read", "label": "Quick Read", "order": 10,
      "patterns": ["read/quick/{persona}.md"] },
    { "id": "read.detailed", "section": "read", "label": "Detailed Read", "order": 11,
      "patterns": ["read/detailed/{persona}.md"] },
    { "id": "read.key_takeaways", "section": "read", "label": "Key Takeaways", "order": 12,
      "patterns": ["read/key_takeaways.md"] },

    { "id": "learn.mindmap", "section": "learn", "label": "Mindmap", "order": 20,
      "patterns": ["learn/mindmap.json", "learn/mindmap.md"] },
    { "id": "learn.study_plan", "section": "learn", "label": "Study Plan", "order": 21,
      "patterns": ["learn/study_plan.md", "learn/study_plan.json"] },
    { "id": "learn.topics", "section": "learn", "label": "Topics", "order": 22,
      "patterns": ["learn/topics/{topicId}/{level}.md", "learn/topics/{topicId}/quick.md", "learn/topics/{topicId}/detailed.md", "learn/topics/{topicId}/podcast.m4a"] },

    { "id": "practice.flashcards", "section": "practice", "label": "Flashcards", "order": 30,
      "patterns": ["practice/flashcards/{persona}.json", "practice/flashcards/revise.json"] },
    { "id": "practice.mcq", "section": "practice", "label": "MCQ", "order": 31,
      "patterns": ["practice/mcq/{difficulty}.json"] },
    { "id": "practice.msq", "section": "practice", "label": "MSQ", "order": 32,
      "patterns": ["practice/msq/{difficulty}.json"] },
    { "id": "practice.question_bank", "section": "practice", "label": "Question Bank", "order": 33,
      "patterns": ["practice/question_bank.json"] },

    { "id": "prepare.previous_year", "section": "prepare", "label": "Previous Year", "order": 40,
      "patterns": ["prepare/previous_year.json"] },
    { "id": "prepare.pre_final_exam", "section": "prepare", "label": "Pre-Final Exam", "order": 41,
      "patterns": ["prepare/pre_final_exam.json", "prepare/pre_final_exam.md"] },
    { "id": "prepare.certification_exam", "section": "prepare", "label": "Certification Exam", "order": 42,
      "patterns": ["prepare/certification_exam.json", "prepare/certification_exam.md"] },
    { "id": "prepare.final_exam", "section": "prepare", "label": "Final Exam", "order": 43,
      "patterns": ["prepare/final_exam.json", "prepare/final_exam.md"] },
    { "id": "prepare.exam_keys", "section": "prepare", "label": "Exam Keys", "order": 44, "hidden": true,
      "patterns": ["prepare/exam_rubric_and_keys.json", "prepare/examination_manifest.json"] },

    { "id": "podcasts", "section": "listen", "label": "Podcasts", "order": 50,
      "patterns": [
        "podcasts/short_podcast.{ext}", "podcasts/long_podcast.{ext}", "podcasts/microcast_{n}.{ext}",
        "podcasts/short_podcast.md", "podcasts/long_podcast.md", "podcasts/microcast_{n}.md",
        "podcasts/short_podcast.transcript.json", "podcasts/long_podcast.transcript.json", "podcasts/microcast_{n}.transcript.json"
      ] }
  ],
  "assets": {
    "chapterMedia": "media/**",
    "tenantAssets": "assets/**",
    "allowedAudio": ["m4a", "mp3"]
  },
  "chapterMetaFiles": ["chapter.json"],
  "subjectMetaFiles": ["subject.json"],
  "tenantMetaFiles": ["tenant.json"]
}
