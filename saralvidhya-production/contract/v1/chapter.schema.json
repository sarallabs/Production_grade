{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChapterConfig",
  "type": "object",
  "required": ["number", "title"],
  "properties": {
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "order": { "type": "number" },
          "topicNum": { "type": "number" }
        }
      }
    }
  }
}
